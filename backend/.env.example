# ============================================================
# 驾考宝典智能查询助手 · 后端环境变量示例
# 使用方式：复制为 backend/.env，并按需修改
# ============================================================

# 全局唯一 API-KEY（必须与 frontend/js/config.js 中的 API_KEY 保持一致）
# 生产环境务必修改为足够随机的字符串，例如 sk-dtk-2026-xxxxxxxxxxxx
DT_API_KEY=sk-dtk-local-2026-change-me

# 兼容 Claude Code 常用的环境变量名：
# 若未设置 DT_API_KEY，则自动读取 ANTHROPIC_API_KEY 作为 API-KEY
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# 服务监听地址与端口
DT_HOST=127.0.0.1
DT_PORT=8000
# 开发时可设为 true 开启热重载
DT_RELOAD=false

# 跨域来源：* 表示全部允许；生产环境建议填写前端域名并逗号分隔
# 例如：http://127.0.0.1:5500,https://exam.example.com
DT_CORS_ORIGINS=*

# 数据目录（生成的试卷 / 上传题库 / 阅卷结果）
# 默认 backend/.data，可改为绝对路径
# DT_DATA_DIR=E:/data/driving-exam-assistant

# 数据保留时间（小时）
DT_EXAM_TTL_HOURS=24
DT_PAPER_TTL_HOURS=24
DT_RESULT_TTL_HOURS=72

# 上传限制
DT_MAX_UPLOAD_MB=2
DT_MAX_UPLOAD_QUESTIONS=300

# 时区（影响试卷编号、生成时间与下载文件名）
DT_TIMEZONE=Asia/Shanghai

# 合格分数线（默认 90）
DT_PASS_SCORE=90
